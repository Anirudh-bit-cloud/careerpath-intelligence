# CareerPath Intelligence Environment Configuration Example

# Backend Database Connection (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite:///./backend/careerpath.db

# Cryptographic Secret for Session Tokens & Webhook Signatures
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Multi-Tenant Workspace Configuration
DEFAULT_WORKSPACE=panw-cyber
DEFAULT_WORKSPACE_NAME="Palo Alto Networks Cyber R&D"

# Server Ports
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Model Hyperparameters
K_CLUSTERS_DEFAULT=4
PROMOTION_GAP_THRESHOLD_YEARS=2.0
RETENTION_URGENT_THRESHOLD=0.75
